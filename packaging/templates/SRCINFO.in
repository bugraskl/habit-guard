pkgbase = habit-guard-bin
	pkgdesc = Catches nail biting, mustache and hair pulling and face touching through your webcam
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/bugraskl/habit-guard
	arch = x86_64
	license = MIT
	depends = dbus
	depends = fontconfig
	depends = libxkbcommon-x11
	depends = xcb-util-cursor
	provides = habit-guard=@VERSION@
	conflicts = habit-guard
	options = !strip
	options = !debug
	source = habit-guard-@VERSION@-linux-x86_64.tar.gz::https://github.com/bugraskl/habit-guard/releases/download/v@VERSION@/HabitGuard-@VERSION@-linux-x86_64.tar.gz
	sha256sums = @LINUX_TAR_SHA256@

pkgname = habit-guard-bin
